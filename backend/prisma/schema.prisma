generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url removed for Prisma 7 config
}

enum Role {
  ADMIN
  ADVISOR
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

enum LeadStage {
  NEW
  INFO_SENT
  CONTACTED
  QUALIFIED
  PRESENTATION
  VISIT
  NEGOTIATION
  CLOSED_WON
  DISCARDED
}

enum InteractionType {
  CALL
  WHATSAPP
  EMAIL
  VISIT
  NOTE
  NEXT_ACTION
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADVISOR)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  leads        Lead[]
  interactions Interaction[]
}

model Lead {
  id           String          @id @default(uuid())
  firstName    String
  lastName     String
  email        String?
  phone        String
  temperature  LeadTemperature @default(WARM)
  stage        LeadStage       @default(NEW)
  source       String?
  budget       Decimal?
  preferredZone String?
  interest     String?         // Description of interest

  nextAction     String?
  nextActionDate DateTime?
  
  advisorId    String?
  advisor      User?    @relation(fields: [advisorId], references: [id])

  interactions Interaction[]
  interests    Interest[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Interaction {
  id        String          @id @default(uuid())
  type      InteractionType
  content   String
  notes     String?
  date      DateTime        @default(now())
  
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  advisorId String?
  advisor   User?    @relation(fields: [advisorId], references: [id])
}

model PropertyUnit {
  id         String   @id @default(uuid())
  name       String
  type       String
  floor      Int?
  area       Decimal?
  bedrooms   String?
  bathrooms  Int?
  price      Decimal
  currency   String   @default("USD")
  status     String   @default("AVAILABLE")
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Interest {
  id         String   @id @default(uuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  notes      String?
  createdAt  DateTime @default(now())
}

model Property {
  id              String   @id @default(uuid())
  name            String
  type            String   @default("PROJECT")
  transaction     String   @default("SALE")
  currency        String   @default("USD")
  price           Decimal?
  status          String   @default("AVAILABLE")

  // Location
  zone            String?
  address         String?
  mapUrl          String?

  // Descriptions
  description     String?
  longDescription String?

  // Areas & Specs
  landArea        Decimal?
  builtArea       Decimal?
  bedrooms        String?
  bathrooms       Int?
  garages         Int?

  // Project Specifics
  deliveryDate    DateTime?
  availability    String?
  
  // Financials
  pricePerSqmFrom Decimal?
  pricePerSqmTo   Decimal?
  exchangeRate    Decimal? @default(6.96)

  // Lists
  paymentMethods  String[]
  equipment       String[]
  amenities       String[]
  images          String[]

  // Contact
  advisorId       String?
  phone           String?
  
  // Relations
  interests       Interest[]
  units           PropertyUnit[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
