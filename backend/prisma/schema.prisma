generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ADVISOR
}

enum LeadTemperature {
  NONE
  COLD
  WARM
  HOT
}

enum LeadStage {
  NEW
  INFO_SENT
  CONTACTED
  QUALIFIED
  PRESENTATION
  VISIT
  NEGOTIATION
  OTHER_REQUIREMENT
  CLOSED_WON
  DISCARDED
}

enum InteractionType {
  CALL
  WHATSAPP
  EMAIL
  VISIT
  NOTE
  NEXT_ACTION
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADVISOR)
  active    Boolean  @default(true)
  phone     String?
  createdAt DateTime @default(now())

  leads        Lead[]
  interactions Interaction[]
}

model Lead {
  id           String          @id @default(uuid())
  firstName    String
  lastName     String
  email        String?
  phone        String
  source       String          @default("MANUAL")
  temperature  LeadTemperature?
  stage        LeadStage       @default(NEW)
  advisorId    String?
  advisor      User?           @relation(fields: [advisorId], references: [id])
  nextAction   String?
  nextActionDate DateTime?
  budget       String?
  city         String?
  preferredZone String?
  timing       String?
  country      String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  interactions Interaction[]
  interests    Interest[]
}

model Interaction {
  id        String          @id @default(uuid())
  leadId    String
  lead      Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      InteractionType
  content   String
  date      DateTime        @default(now())
  advisorId String?
  advisor   User?           @relation(fields: [advisorId], references: [id])
}

model Interest {
  id         String   @id @default(uuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  notes      String?
  createdAt  DateTime @default(now())
}

model Property {
  id              String   @id @default(uuid())
  name            String
  type            String   @default("PROJECT")
  transaction     String   @default("SALE")
  currency        String   @default("USD")
  price           Decimal?
  status          String   @default("AVAILABLE")

  // Location
  zone            String?
  address         String?
  mapUrl          String?

  // Descriptions
  description     String?
  longDescription String?

  // Areas & Specs
  landArea        Decimal?
  builtArea       Decimal?
  bedrooms        String?
  bathrooms       Int?
  garages         Int?

  // Project Specifics
  deliveryDate    DateTime?
  availability    String?
  
  // Financials
  pricePerSqmFrom Decimal?
  pricePerSqmTo   Decimal?
  exchangeRate    Decimal? @default(6.96)

  // Lists
  paymentMethods  String[]
  equipment       String[]
  amenities       String[]
  images          String[]

  // Contact
  advisorId       String?
  phone           String?
  
  // Relations
  interests       Interest[]
  units           PropertyUnit[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PropertyUnit {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name        String
  type        String   @default("APARTMENT")
  price       Decimal
  currency    String   @default("USD")
  status      String   @default("AVAILABLE")

  floor       String?
  area        Decimal?
  bedrooms    String?
  bathrooms   Int?
  features    String[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
